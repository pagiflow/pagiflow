{
  "name": "pagiflow",
  "private": true,
  "version": "4.0.1",
   "description": "Pagiflow is a high-performance, zero-dependency slider for Vanilla JS, React, Vue, Svelte, Angular, and Solid JS.",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "bench:browser": "node scripts/browser-benchmark.mjs",
    "ci:verify": "pnpm test && pnpm typecheck && pnpm build",
    "clean": "turbo clean",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vue/test-utils": "^2.4.10",
    "axe-core": "^4.11.4",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "turbo": "^1.13.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@8.15.0",
  "main": "index.js",
  "dependencies": {
    "prettier": "^2.8.8"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
